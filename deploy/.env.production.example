# ==============================================================================
# SUCHARU PRO ERP — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: NEVER commit real passwords, signing secrets, or private keys to git.
# In production, inject these variables via Docker Compose secrets, HashiCorp Vault,
# AWS Secrets Manager, or Kubernetes Secret resources.

# ==============================================================================
# 1. APPLICATION & RELEASE IDENTITY
# ==============================================================================
APP_NAME=sucharu-backend
APP_VERSION=1.0.0
BUILD_VERSION=1.0.0-PROD
GIT_COMMIT=HEAD
BUILD_TIMESTAMP=2026-08-25T00:00:00Z
ENVIRONMENT=production
APP_ENV=production

# ==============================================================================
# 2. HTTP SERVER EDGE
# ==============================================================================
SERVER_HOST=0.0.0.0
PORT=8080
SERVER_PORT=8080
LOG_LEVEL=INFO

# ==============================================================================
# 3. DATABASE & CONNECTION POOL (POSTGRESQL)
# ==============================================================================
# In production, specify explicit host (not localhost), port, database name, and strong credentials.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=sucharu_pro_db
DATABASE_USER=sucharu_app
DATABASE_PASSWORD=CHANGE_ME_TO_A_SECURE_STRONG_PASSWORD_IN_PRODUCTION
DATABASE_URL=jdbc:postgresql://postgres:5432/sucharu_pro_db
DATABASE_POOL_SIZE=20
DATABASE_MIN_IDLE=5
DATABASE_CONN_TIMEOUT_MS=30000
DATABASE_SSL_MODE=prefer

# ==============================================================================
# 4. REDIS ACCELERATION & CACHE (OPTIONAL)
# ==============================================================================
REDIS_ENABLED=false
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
REDIS_TIMEOUT_MS=2000

# ==============================================================================
# 5. AUTHENTICATION & SECURITY AUTHORITY (JWT)
# ==============================================================================
# MUST be a cryptographically random string of at least 32 characters (256 bits).
# NEVER use "dev", "test", or default values in production.
JWT_SIGNING_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHAR_CRYPTOGRAPHIC_KEY_IN_PROD
JWT_ISSUER=sucharu-backend-server
JWT_AUDIENCE=sucharu-api-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ==============================================================================
# 6. BACKGROUND WORKERS & JOB QUEUE
# ==============================================================================
WORKER_POOL_SIZE=10
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_DURATION_MS=30000

# ==============================================================================
# 7. EXTERNAL INTEGRATIONS & WEBHOOKS
# ==============================================================================
INTEGRATION_CONNECT_TIMEOUT_MS=5000
INTEGRATION_READ_TIMEOUT_MS=10000
WEBHOOK_REPLAY_MAX_AGE_SECONDS=300

# ==============================================================================
# 8. DATABASE MIGRATIONS (FLYWAY)
# ==============================================================================
FLYWAY_ENABLED=true
MIGRATION_MODE=AUTO_APPLY

# ==============================================================================
# 9. OBSERVABILITY & TELEMETRY
# ==============================================================================
OBSERVABILITY_ENABLED=true
METRICS_ENABLED=true
METRICS_ENDPOINT_ENABLED=true
SLOW_REQUEST_THRESHOLD_MS=1000
HEALTH_CHECK_TIMEOUT_MS=2000
METRICS_AUTH_REQUIRED=false

# ==============================================================================
# 10. GRACEFUL SHUTDOWN
# ==============================================================================
GRACEFUL_SHUTDOWN_TIMEOUT_MS=5000
