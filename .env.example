# ==============================================================================
# SUCHARU PRO — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Copy this file to `.env` and replace password values with strong secure secrets.
# DO NOT commit real `.env` files with actual passwords to Git.

# Application Environment
ENVIRONMENT=production
PORT=8080

# PostgreSQL Database Configuration
DATABASE_NAME=sucharu_pro_db
DATABASE_USER=sucharu_app
DATABASE_PASSWORD=ChangeThisToAStrongSecurePassword2026!

# JWT Security Signing Secret (Must be at least 32 characters)
JWT_SIGNING_SECRET=ChangeThisToAtLeast32CharactersSecretSigningKey2026!
